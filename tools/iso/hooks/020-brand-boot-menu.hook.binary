#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

GRUB_CONFIG=binary/boot/grub/grub.cfg
LIVE_ENTRY='Live system (amd64)'

if [ ! -f "$GRUB_CONFIG" ]; then
    echo "Expected GRUB configuration was not generated: $GRUB_CONFIG" >&2
    exit 1
fi

if ! grep -Fq "menuentry \"$LIVE_ENTRY\"" "$GRUB_CONFIG"; then
    echo "Could not find the expected Debian Live GRUB entry." >&2
    exit 1
fi

sed -i 's/Live system (amd64)/AureaOS/g' "$GRUB_CONFIG"

if grep -Fq "Live system (amd64)" "$GRUB_CONFIG"; then
    echo "A Debian Live menu label remains in the GRUB configuration." >&2
    exit 1
fi

if grep -Eq '^[[:space:]]*set timeout=' "$GRUB_CONFIG"; then
    sed -i -E 's/^[[:space:]]*set timeout=.*/set timeout=5/' "$GRUB_CONFIG"
else
    echo "GRUB timeout setting was not found; refusing an unverified boot menu." >&2
    exit 1
fi

if grep -Eq '^[[:space:]]*set default=' "$GRUB_CONFIG"; then
    sed -i -E 's/^[[:space:]]*set default=.*/set default=0/' "$GRUB_CONFIG"
else
    echo "GRUB default entry setting was not found; refusing an unverified boot menu." >&2
    exit 1
fi
