#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

SOURCE=/usr/src/aureaos
SYSTEMD_SOURCE=/usr/src/aureaos/tools/iso/systemd/aurea-desktop.service
PAM_SOURCE=/usr/src/aureaos/tools/iso/pam/aurea-desktop
SESSION_SOURCE=/usr/src/aureaos/tools/iso/scripts/aurea-live-session

if [ ! -f "$SOURCE/Cargo.toml" ] || [ ! -f "$SOURCE/Cargo.lock" ]; then
    echo "AureaOS source tree or Cargo.lock is missing." >&2
    exit 1
fi

if [ ! -f "$SYSTEMD_SOURCE" ] || [ ! -f "$PAM_SOURCE" ] || [ ! -f "$SESSION_SOURCE" ]; then
    echo "AureaOS Live session integration files are missing." >&2
    exit 1
fi

if [ ! -f /usr/lib/x86_64-linux-gnu/security/pam_systemd.so ]; then
    echo "Debian systemd PAM module is missing; cannot register the AureaOS logind session." >&2
    exit 1
fi

export CARGO_HOME=/var/cache/aureaos-cargo
export RUSTUP_HOME=/var/cache/aureaos-rustup
export CARGO_NET_RETRY=3
export CARGO_HTTP_TIMEOUT=120
export CARGO_BUILD_JOBS=1
export CARGO_INCREMENTAL=0

# Debian Trixie's packaged Rust compiler is older than the MSRV of some
# locked AureaOS dependencies. Use the official stable toolchain only here.
RUSTUP_INSTALLER=/tmp/aureaos-rustup-init.sh
curl --fail --location --retry 3 --proto '=https' --tlsv1.2 \
    --silent --show-error --output "$RUSTUP_INSTALLER" https://sh.rustup.rs
sh "$RUSTUP_INSTALLER" -y --profile minimal --default-toolchain stable --no-modify-path
rm -f "$RUSTUP_INSTALLER"
export PATH="$CARGO_HOME/bin:$PATH"

rustc +stable --version
# live-build executes chroot hooks from /, so always anchor Cargo to the
# extracted workspace instead of relying on the hook's current directory.
cargo +stable build \
    --manifest-path "$SOURCE/Cargo.toml" \
    --release --locked \
    --features heif \
    --package aurea-desktop \
    --bin aurea-desktop

install -D -m 0755 "$SOURCE/target/release/aurea-desktop" /usr/local/bin/aurea-desktop

# Build both native Xcursor palettes from the canonical SVG masters inside
# the Debian target. Only the generated Xcursor payload is copied into /usr.
CURSOR_SOURCE="$SOURCE/aurea-human-interfaces/cursors"
python3 "$SOURCE/tools/assets/build_cursor_theme.py" \
    --cursor-dir "$CURSOR_SOURCE" \
    --output "$CURSOR_SOURCE/generated/AureaOS-Light"
python3 "$SOURCE/tools/assets/build_cursor_theme.py" \
    --cursor-dir "$CURSOR_SOURCE" \
    --manifest "$CURSOR_SOURCE/manifest-dark.toml" \
    --output "$CURSOR_SOURCE/generated/AureaOS-Dark"
install -d -m 0755 /usr/share/icons
cp -a "$CURSOR_SOURCE/generated/AureaOS-Light" /usr/share/icons/
cp -a "$CURSOR_SOURCE/generated/AureaOS-Dark" /usr/share/icons/

install -D -m 0644 "$SYSTEMD_SOURCE" /etc/systemd/system/aurea-desktop.service
install -D -m 0644 "$PAM_SOURCE" /etc/pam.d/aurea-desktop
install -D -m 0755 "$SESSION_SOURCE" /usr/local/bin/aurea-live-session

# The coordinator rasterizes approved SVGs in the disposable builder and
# stages only raw RGBA8 files into the chroot include tree. Verify that payload
# before the desktop binary can be published into the Live rootfs.
ASSET_ROOT="/usr/share/aureaos/human-interfaces/icons/generated/context-menu"
for theme in light dark; do
    asset="$ASSET_ROOT/context-menu-$theme-256.rgba"
    [ -s "$asset" ] || {
        echo "AureaOS $theme context-menu artwork is missing from the target rootfs." >&2
        exit 1
    }
    [ "$(stat -c '%s' "$asset")" = 262144 ] || {
        echo "AureaOS $theme context-menu artwork has an invalid byte length." >&2
        exit 1
    }
done

# Catch missing runtime libraries while still inside the Debian target rootfs.
# This is especially important because Cargo only guarantees a successful link
# against the build container's libraries, not the final Live image contents.
if ! ldd /usr/local/bin/aurea-desktop > /tmp/aurea-desktop.ldd 2>&1; then
    cat /tmp/aurea-desktop.ldd >&2
    echo "Unable to inspect the AureaOS desktop runtime dependencies." >&2
    exit 1
fi
if grep -Fq 'not found' /tmp/aurea-desktop.ldd; then
    cat /tmp/aurea-desktop.ldd >&2
    echo "AureaOS desktop has unresolved shared-library dependencies in Debian." >&2
    exit 1
fi
rm -f /tmp/aurea-desktop.ldd

if ! id aurea >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash aurea
fi

# Validate the exact unit file with Debian's systemd after its configured user
# exists, then enable the session service.
systemd-analyze verify /etc/systemd/system/aurea-desktop.service

# The dedicated PAM service calls pam_systemd directly. Explicit session
# metadata associates the unprivileged compositor with seat0 on tty1.
systemctl --root=/ mask getty@.service
systemctl --root=/ enable aurea-desktop.service
systemctl --root=/ set-default multi-user.target
systemctl --root=/ is-enabled aurea-desktop.service >/dev/null || {
    echo "AureaOS desktop service was not enabled in the target system." >&2
    exit 1
}

# Rebuild and inspect the initramfs before removing build dependencies.
# If this preflight fails, the live-build chroot can safely rerun this hook.
/usr/local/libexec/aureaos/validate-chroot-boot.sh

# Remove only explicitly listed build tools and development headers after all
# failure-prone compilation, session and boot checks have completed. Do not run
# autoremove: runtime dependencies must remain in the live image.
DEBIAN_FRONTEND=noninteractive apt-get purge -y -- \
    curl build-essential pkg-config glslang-tools \
    libvulkan-dev libudev-dev libinput-dev libseat-dev libgbm-dev \
    libdrm-dev libxkbcommon-dev libwayland-dev libheif-dev \
    libturbojpeg0-dev

# Keep build sources, Rust toolchains and Cargo caches out of the live system.
rm -rf "$SOURCE" "$CARGO_HOME" "$RUSTUP_HOME"
