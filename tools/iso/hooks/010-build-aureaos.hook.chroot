#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

SOURCE=/usr/src/aureaos

if [ ! -f "$SOURCE/Cargo.toml" ] || [ ! -f "$SOURCE/Cargo.lock" ]; then
    echo "AureaOS source tree or Cargo.lock is missing." >&2
    exit 1
fi

export CARGO_HOME=/var/cache/aureaos-cargo
export CARGO_NET_RETRY=3
export CARGO_HTTP_TIMEOUT=120

cd "$SOURCE"
cargo build --release --locked --package aurea-desktop --bin aurea-desktop
install -D -m 0755 target/release/aurea-desktop /usr/local/bin/aurea-desktop

getent group render >/dev/null 2>&1 || groupadd --system render
getent group video >/dev/null 2>&1 || groupadd --system video
getent group input >/dev/null 2>&1 || groupadd --system input
if ! id aurea >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --groups video,input,render aurea
fi

install -d -m 0755 /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin aurea --noclear %I $TERM
EOF

cat > /usr/local/bin/aurea-live-session <<'EOF'
#!/bin/bash
/usr/local/bin/aurea-desktop
status=$?
printf '\nAureaOS desktop exited with status %s. A recovery shell is available.\n' "$status"
exec /bin/bash --noprofile --norc
EOF
chmod 0755 /usr/local/bin/aurea-live-session

cat > /home/aurea/.bash_profile <<'EOF'
if [[ "$(tty 2>/dev/null)" == "/dev/tty1" ]]; then
    exec /usr/local/bin/aurea-live-session
fi
EOF
chown aurea:aurea /home/aurea/.bash_profile
chmod 0644 /home/aurea/.bash_profile

# Remove the temporary compiler and headers; retain only runtime libraries.
DEBIAN_FRONTEND=noninteractive apt-get purge -y -- \
    rustc cargo build-essential pkg-config glslang-tools \
    libvulkan-dev libudev-dev libinput-dev libseat-dev libgbm-dev \
    libdrm-dev libxkbcommon-dev libwayland-dev
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y --purge

# Keep build sources and Cargo caches out of the booted live system.
rm -rf "$SOURCE" "$CARGO_HOME"
