#
# AureaOS native graphical session.
# The dedicated PAM service registers this Wayland session with logind.

[Unit]
Description=AureaOS Native Desktop Session
Documentation=https://github.com/AleessandroCeccarelli/AureaOs
After=systemd-logind.service systemd-user-sessions.service
Wants=systemd-logind.service
Conflicts=getty@tty1.service
Before=getty@tty1.service
ConditionFileIsExecutable=/usr/local/bin/aurea-live-session

[Service]
Type=simple
User=aurea
PAMName=aurea-desktop
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
Environment=RUST_BACKTRACE=1
Environment=AUREAOS_LIVE_MINIMAL=1
Environment=LIBSEAT_BACKEND=logind
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SESSION_DESKTOP=AureaOS
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=1
ExecStart=/usr/local/bin/aurea-live-session
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
