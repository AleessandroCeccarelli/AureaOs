
# SPDX-License-Identifier: GPL-3.0-only
# AureaOS — repository-wide ignore rules

# ----------------------------------------------------------------------
# Rust / Cargo
# ----------------------------------------------------------------------

/target/
**/target/

Cargo.lock
# Keep Cargo.lock for applications and workspaces when reproducible builds
# are required. Uncomment the next line if the repository should track it.
#!Cargo.lock

# Rust compiler and analyzer artifacts
*.rs.bk
*.rlib
*.rmeta
*.d
*.profraw
*.profdata

# ----------------------------------------------------------------------
# Linux build artifacts
# ----------------------------------------------------------------------

*.o
*.a
*.so
*.so.*
*.ko
*.mod
*.mod.c
*.symvers
*.order
.Module.symvers.cmd
.modules.order.cmd

# CMake / Make / Ninja
/build/
/cmake-build-*/
/CMakeFiles/
/CMakeCache.txt
/Makefile
/ninja-build/
.ninja_deps
.ninja_log

# Linux packages and images
*.deb
*.rpm
*.AppImage
*.iso
*.img
*.raw
*.qcow2
*.vdi
*.vmdk
*.vhd
*.vhdx

# ----------------------------------------------------------------------
# macOS / Xcode
# ----------------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
._*

# Xcode user data and build products
DerivedData/
*.xcuserstate
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM/
*.dSYM.zip
*.xcarchive/
*.app/

# Xcode project user-specific settings
xcuserdata/
*.xcuserdatad/
*.mode1v3
*.mode2v3
*.perspectivev3
*.pbxuser
!default.pbxuser
!*.xcuserdatad/

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# ----------------------------------------------------------------------
# IDEs and editors
# ----------------------------------------------------------------------

.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
*.bak

# ----------------------------------------------------------------------
# Logs, caches, temporary files
# ----------------------------------------------------------------------

*.log
*.trace
*.cache
.cache/
.tmp/
temp/
tmp/

# ----------------------------------------------------------------------
# Test and coverage output
# ----------------------------------------------------------------------

/coverage/
*.lcov
*.gcda
*.gcno
*.prof

# ----------------------------------------------------------------------
# AureaOS generated artifacts
# ----------------------------------------------------------------------

/artifacts/
/dist/
/out/
/output/
/rootfs/
/staging/
/sysroot/
/iso/
/images/
/packages/
/generated/

# Generated documentation
/docs/_build/
/site/

# ----------------------------------------------------------------------
# Local environment and secrets
# ----------------------------------------------------------------------

.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
